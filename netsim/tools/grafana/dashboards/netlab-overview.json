{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": [ "netlab" ],
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "",
  "title": "netlab overview",
  "uid": "netlab-overview",
  "version": 1,
  "weekStart": "",
  "templating": {
    "list": [
      {
        "name": "filter",
        "label": "Container filter",
        "type": "textbox",
        "query": "clab-.*",
        "current": { "text": "clab-.*", "value": "clab-.*" },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(container_last_seen{name=~\"$filter\"}, name)",
        "query": {
          "query": "label_values(container_last_seen{name=~\"$filter\"}, name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "options": [],
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Fleet Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Containers running",
      "description": "Number of lab containers currently reporting metrics.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(count by (name) (container_last_seen{name=~\"$filter\"}))",
          "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Total CPU (cores)",
      "description": "Aggregate CPU usage across all lab containers, in cores.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"$filter\"}[1m]))",
          "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Total memory",
      "description": "Aggregate memory used across all lab containers.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "decmbytes",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(container_memory_usage_bytes{name=~\"$filter\"}) / 1024 / 1024",
          "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Fleet RX traffic",
      "description": "Aggregate received traffic across all lab containers.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "bps",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(container_network_receive_bytes_total{name=~\"$filter\"}[1m])) * 8",
          "refId": "A" }
      ]
    },
    {
      "type": "row",
      "id": 10,
      "title": "Per-node Resource Usage",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "CPU usage per node",
      "description": "Per-container CPU usage in percent (1 core = 100%).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$filter\"}[1m])) * 100",
          "legendFormat": "{{name}}",
          "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Memory usage per node",
      "description": "Per-container memory usage in MB.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "decmbytes",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name) (container_memory_usage_bytes{name=~\"$filter\"}) / 1024 / 1024",
          "legendFormat": "{{name}}",
          "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "RX traffic per node",
      "description": "Per-container received traffic in bits/second.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bps",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"$filter\"}[1m])) * 8",
          "legendFormat": "{{name}}",
          "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "TX traffic per node",
      "description": "Per-container transmitted traffic in bits/second.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bps",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"$filter\"}[1m])) * 8",
          "legendFormat": "{{name}}",
          "refId": "A" }
      ]
    },
    {
      "type": "row",
      "id": 20,
      "title": "Node Detail — $node",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "CPU usage — $node",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=\"$node\"}[1m])) * 100",
          "legendFormat": "CPU %",
          "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "Memory usage — $node",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "decmbytes",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(container_memory_usage_bytes{name=\"$node\"}) / 1024 / 1024",
          "legendFormat": "Memory MB",
          "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "id": 23,
      "title": "Interface RX — $node",
      "description": "Received traffic per interface on the selected node.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": {
        "defaults": {
