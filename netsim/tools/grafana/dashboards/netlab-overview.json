          "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "id": 24,
      "title": "Interface TX — $node",
      "description": "Transmitted traffic per interface on the selected node.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
