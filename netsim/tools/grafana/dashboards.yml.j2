#
# Grafana dashboard provisioning -- generated by netlab
#
# Grafana loads every dashboard JSON file it finds in /var/lib/grafana/dashboards
# (the lab's grafana/dashboards directory). Drop your own *.json dashboards there
# to have them show up automatically.
#
---
apiVersion: 1

providers:
- name: netlab
  orgId: 1
  folder: netlab
  type: file
  disableDeletion: false
  editable: true
  updateIntervalSeconds: 10
  allowUiUpdates: true
  options:
    path: /var/lib/grafana/dashboards
    foldersFromFilesStructure: false
