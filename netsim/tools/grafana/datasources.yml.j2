#
# Grafana datasource provisioning -- generated by netlab
#
# The Prometheus container is reachable by its container name on the lab
# management network. The datasource UID is fixed to 'prometheus' so that
# community dashboards (and the netlab default dashboard) work unchanged.
#
---
apiVersion: 1

datasources:
- name: Prometheus
  type: prometheus
  uid: prometheus
  access: proxy
  url: http://{{ name }}_prometheus:9090
  isDefault: true
  editable: true
